<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_delivery_notification_prac" model="mail.template">
            <field name="name">Delivery Order Update</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="subject">Delivery Order for {{ object.sale_id.name or 'Sales Order' }} is Completed</field>
            <field name="email_from">{{ user.email}}</field>
            <field name="email_to">{{ object.sale_id.user_id.partner_id.email or '' }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Dear
                        <t t-out="object.sale_id.user_id.name or 'Salesperson'"/>
                        ,
                    </p>
                    <p>
                        This is to inform you that the delivery associated with
                        <strong>
                            <t t-out="object.sale_id.name"/>
                        </strong>
                        has been successfully completed.
                        The delivery reference is
                        <strong>
                            <t t-out="object.name"/>
                        </strong>
                        .
                    </p>
                    <p>
                        Please check the attached delivery document for your reference.
                    </p>
                    <p>
                        Regards,
                        <br/>
                        <t t-out="user.name"/>
                        <br/>
                        <t t-if="user.signature">
                            <t t-out="user.signature"/>
                        </t>
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('stock.action_report_delivery'))]"/>
        </record>
    </data>
</odoo>
